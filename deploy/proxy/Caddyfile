{
  admin off
  auto_https off
}

:8080 {
  encode zstd gzip

  request_body {
    max_size 512KB
  }

  header {
    -Server
    Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; font-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
    Cross-Origin-Opener-Policy "same-origin"
    Cross-Origin-Resource-Policy "same-origin"
    Permissions-Policy "camera=(), geolocation=(), microphone=(), payment=(), usb=()"
    Referrer-Policy "no-referrer"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "DENY"
  }

  route {
    # Reject declared oversized bodies before a disabled endpoint can answer
    # without reading them. request_body remains the streaming/read backstop.
    @oversized header_regexp Content-Length ^(?:[6-9][0-9]{5}|5[2-9][0-9]{4}|51[3-9][0-9]{3}|512(?:00[1-9]|0[1-9][0-9]|[1-9][0-9]{2})|[0-9]{7,})$
    handle @oversized {
      respond 413
    }

    @health path /healthz
    handle @health {
      respond "ok" 200
    }

    @reserved path /docs /docs/* /redoc /redoc/* /openapi.json /.env /.env.* /.git /.git/*
    handle @reserved {
      respond 404
    }

    @api path /api/* /.well-known/agent-card.json
    handle @api {
      header Cache-Control "no-store"
      reverse_proxy api:8000 {
        transport http {
          dial_timeout 3s
          response_header_timeout 45s
          read_timeout 6m
          write_timeout 45s
        }
      }
    }

    handle {
      @assets path /assets/*
      header @assets Cache-Control "public, max-age=31536000, immutable"
      reverse_proxy web:8080 {
        transport http {
          dial_timeout 3s
          response_header_timeout 10s
        }
      }
    }
  }
}
