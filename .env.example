# Optional local ports. No API key is required for deterministic Mock mode.
AGENT_TRACE_API_PORT=8000
AGENT_TRACE_WEB_PORT=4173

# Public-preview Compose defaults. Keep the local origin exact; never use `*`.
AGENT_TRACE_PUBLIC_PORT=47800
AGENT_TRACE_PUBLIC_ORIGIN=http://127.0.0.1:47800
AGENT_TRACE_SSE_MAX_LIFETIME_SECONDS=300
AGENT_TRACE_IMAGE_TAG=0.1.0-rc.2

# HTTPS VM override (`docker compose -f compose.yaml -f compose.https.yaml ...`).
# AGENT_TRACE_PUBLIC_HOST=trace.example.com
# AGENT_TRACE_PUBLIC_ORIGIN=https://trace.example.com
# AGENT_TRACE_ACME_EMAIL=ops@example.com
