{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-trace.local/schemas/lesson-catalog/1-0-0",
  "title": "LessonCatalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "lessons"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "lessons": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "module", "title", "scenario_id", "objective", "input_case", "prediction", "completion_assertions"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,95}$"},
          "module": {"type": "string", "pattern": "^M(?:[0-9]|1[01])$"},
          "title": {"type": "string", "minLength": 1, "maxLength": 120},
          "scenario_id": {"type": "string", "minLength": 1},
          "objective": {"type": "string", "minLength": 1, "maxLength": 500},
          "prior_knowledge": {"type": "array", "items": {"type": "string"}},
          "input_case": {"type": "string", "minLength": 1},
          "prediction": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "prompt", "options"],
            "properties": {
              "type": {"enum": ["single_choice", "multi_choice", "state_patch", "route", "free_text"]},
              "prompt": {"type": "string", "minLength": 1},
              "options": {"type": "array", "items": {"type": "string"}},
              "expected": {}
            }
          },
          "failure_challenge": {"type": "string"},
          "explain_back": {"type": "string"},
          "completion_assertions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}
        }
      }
    }
  }
}
