{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-trace.local/schemas/answer-payload/1-0-0",
  "title": "AnswerPayload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "answer_markdown",
    "summary",
    "claims",
    "evidence_ids",
    "confidence",
    "limitations",
    "proposed_actions",
    "requires_human_review",
    "run_id"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "answer_markdown": {
      "type": "string",
      "minLength": 1,
      "maxLength": 50000
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text",
          "evidence_ids"
        ],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "evidence_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "evidence_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "confidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "reasons"
      ],
      "properties": {
        "label": {
          "enum": [
            "high",
            "medium",
            "low",
            "not_applicable"
          ]
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "chart_spec": {
      "oneOf": [
        {
          "$ref": "chart-dsl.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "proposed_actions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "action_id",
          "label",
          "risk",
          "tool_name"
        ],
        "properties": {
          "action_id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "risk": {
            "enum": [
              "read",
              "compute",
              "propose",
              "write",
              "restricted"
            ]
          },
          "tool_name": {
            "type": "string",
            "minLength": 1
          },
          "arguments": {
            "type": "object"
          }
        }
      }
    },
    "requires_human_review": {
      "type": "boolean"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    }
  }
}
