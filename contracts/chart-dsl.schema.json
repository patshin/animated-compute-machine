{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-trace.local/schemas/chart-dsl/1-0-0",
  "title": "ChartSpec",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "title",
    "dataset_ref",
    "encoding"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "kind": {
      "enum": [
        "metric",
        "table",
        "line",
        "bar",
        "scatter",
        "heatmap",
        "timeline"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "subtitle": {
      "type": "string",
      "maxLength": 240
    },
    "dataset_ref": {
      "type": "string",
      "pattern": "^artifact:[A-Za-z0-9_-]+$"
    },
    "encoding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "x": {
          "$ref": "#/$defs/field"
        },
        "y": {
          "$ref": "#/$defs/fieldOrFields"
        },
        "series": {
          "$ref": "#/$defs/field"
        },
        "value": {
          "$ref": "#/$defs/field"
        },
        "label": {
          "$ref": "#/$defs/field"
        },
        "columns": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/field"
          }
        }
      }
    },
    "unit": {
      "type": "string",
      "maxLength": 32
    },
    "source_evidence_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "takeaway": {
      "type": "string",
      "maxLength": 500
    }
  },
  "$defs": {
    "field": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$"
    },
    "fieldOrFields": {
      "oneOf": [
        {
          "$ref": "#/$defs/field"
        },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/field"
          }
        }
      ]
    }
  }
}
