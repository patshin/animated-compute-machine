{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-trace.local/schemas/tool-catalog/1-0-0",
  "title": "ToolCatalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "tools"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "tools": {"type": "array", "minItems": 1, "items": {"$ref": "tool-spec.schema.json"}}
  }
}
