{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-trace.local/schemas/agent-event/1-0-0",
  "title": "AgentEvent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "run_id",
    "sequence",
    "type",
    "timestamp",
    "correlation_id",
    "payload",
    "redaction"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "event_id": {
      "type": "string",
      "pattern": "^evt_[A-Za-z0-9_-]+$",
      "maxLength": 128
    },
    "run_id": {
      "type": "string",
      "pattern": "^run_[A-Za-z0-9_-]+$",
      "maxLength": 128
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "type": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)+$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "node_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-z][a-z0-9_]{1,63}$"
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1
    },
    "causation_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "payload_version": {
      "const": "1.0.0",
      "default": "1.0.0"
    },
    "payload": {
      "type": "object"
    },
    "redaction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "redacted"
      ],
      "properties": {
        "redacted": {
          "type": "boolean"
        },
        "paths": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
